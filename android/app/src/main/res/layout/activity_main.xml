<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vtuber AI"
            android:textColor="#ff5fd0"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Живой аватар поверх любого приложения: тап — разговор голосом, двойной тап — настройки, долгий тап — приватный режим."
            android:textColor="#c9c2e8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="#241141"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:text="Проверяю…"
            android:textColor="#ffffff"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_overlay"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:backgroundTint="#4a6fa5"
            android:text="Показать аватар"
            android:textColor="#ffffff" />

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#3a5a8a"
            android:text="Настройки"
            android:textColor="#ffffff" />

        <Button
            android:id="@+id/btn_hide"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#6b2f5e"
            android:text="Скрыть аватар"
            android:textColor="#ffffff" />
    </LinearLayout>
</ScrollView>
